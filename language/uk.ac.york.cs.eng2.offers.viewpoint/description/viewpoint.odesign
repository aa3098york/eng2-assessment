<?xml version="1.0" encoding="UTF-8"?>
<description:Group xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:description="http://www.eclipse.org/sirius/description/1.1.0" xmlns:description_1="http://www.eclipse.org/sirius/diagram/description/1.1.0" xmlns:style="http://www.eclipse.org/sirius/diagram/description/style/1.1.0" name="viewpoint" version="12.0.0.2017041100">
  <ownedViewpoints name="Viewpoint" modelFileExtension="offers">
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="offers.diagram.offers" label="Offers Diagram" domainClass="offers::Model" enablePopupBars="true">
      <metamodel href="../../uk.ac.york.cs.eng2.offers/model/offers.ecore#/"/>
      <defaultLayer name="Default">
        <nodeMappings name="offers.singleofferrule.node" label="Single Offer Rule Node" semanticCandidatesExpression="feature:offerRules" domainClass="offers::SingleOfferRule">
          <style xsi:type="style:SquareDescription" labelSize="12" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_blue']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="offers.multifofferrule.node" label="Multi Offer Rule Node" semanticCandidatesExpression="feature:offerRules" domainClass="offers::MultiOfferRule">
          <style xsi:type="style:SquareDescription" labelSize="12" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='purple']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="offers.products.node" label="Product Node" domainClass="Product">
          <style xsi:type="style:EllipseNodeDescription" labelSize="12" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='green']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="offers.fixeddiscountaction.node" label="Fixed Amount Discount Action Node" domainClass="offers::FixedAmountDiscountAction">
          <style xsi:type="style:SquareDescription" labelSize="12" labelExpression="aql:'Remove £' + self.discountAmount + ' from order total'" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="offers.percentageorderaction.node" label="Percentage Discount Action Node" domainClass="offers::PercentageDiscountAction">
          <style xsi:type="style:SquareDescription" labelSize="12" labelExpression="aql:self.discountPercentage + '% off of order'" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="offers.productpercentaction.node" label="Product Percentage Discount Action Node" domainClass="offers::PercentageProductDiscountAction">
          <style xsi:type="style:SquareDescription" labelSize="12" labelExpression="aql:self.discountPercentage + '% off of product'" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="offers.fiedpriceaction.node" label="Set Fixed Price Action Node" domainClass="offers::SetFixedPriceAction">
          <style xsi:type="style:SquareDescription" labelSize="12" labelExpression="aql:'Set order price to £' + self.fixedPrice" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="offers.freeitemaction.node" label="Free Item Action Node" domainClass="offers::FreeItemAction">
          <style xsi:type="style:SquareDescription" labelSize="12" labelExpression="Free Item" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="offers.minordervaluecondition.node" label="Min Order Value Condition Node" domainClass="offers::MinOrderValueCondition">
          <style xsi:type="style:LozengeNodeDescription" labelSize="12" labelExpression="aql:'Order Total >= £'+ self.minimumAmount + '?'" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="offers.firstnorderscondition.node" label="First N Orders Condition Node" domainClass="offers::FirstNOrdersCondition">
          <style xsi:type="style:LozengeNodeDescription" labelSize="12" labelExpression="aql:'First '+ self.numberOfOrders  + ' Orders on ' + self.day + '?'" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="offers.containsproductcondition.node" label="Contains Product Condition Node" domainClass="offers::ContainsProductCondition">
          <style xsi:type="style:LozengeNodeDescription" labelSize="12" labelExpression="aql:'Contains Product?'" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="offers.producttagcondition.node" label="Product Tag Condition Node" domainClass="offers::ProductTagCondition">
          <style xsi:type="style:LozengeNodeDescription" labelSize="12" labelExpression="aql:self.eClass().name" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="offers.productquantitycondition.node" label="Product Quantity Condition Node" domainClass="offers::ProductQuantityCondition">
          <style xsi:type="style:LozengeNodeDescription" labelSize="12" labelExpression="aql:'Product Quantity = ' + self.quantity + '?'" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="offers.orderdatecondition.node" label="Order Date Condition Node" domainClass="offers::OrderDateCondition">
          <style xsi:type="style:LozengeNodeDescription" labelSize="12" labelExpression="aql:'Order Date = '+ self.date+ '?'" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
          </style>
        </nodeMappings>
        <edgeMappings name="offers.triggerrule.edge" label="Trigger Rule Edge" semanticCandidatesExpression="aql:self.offerRules.triggerRule" sourceMapping="//@ownedViewpoints[name='Viewpoint']/@ownedRepresentations[name='offers.diagram.offers']/@defaultLayer/@nodeMappings[name='offers.singleofferrule.node']" targetMapping="//@ownedViewpoints[name='Viewpoint']/@ownedRepresentations[name='offers.diagram.offers']/@defaultLayer/@nodeMappings[name='offers.multifofferrule.node']" targetFinderExpression="aql:self.eContainer()" sourceFinderExpression="feature:secondaryRule" domainClass="offers::TriggerRule" useDomainElement="true">
          <style sourceArrow="InputArrow" targetArrow="NoDecoration" sizeComputationExpression="2" endsCentering="Both">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
            <centerLabelStyleDescription labelSize="12" showIcon="false" labelExpression="aql:self.trigger">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
