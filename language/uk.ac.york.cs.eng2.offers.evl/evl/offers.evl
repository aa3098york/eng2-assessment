// Write your EVL validation rules here.
//
// To run them, right-click on the Sirius diagram background and select "Validate diagram".
context Product {
    constraint UniqueProductName {
        check : Product.allInstances().forAll(p1 | Product.allInstances().forAll(p2 | p1.name <> p2.name or p1 = p2))
        message : 'Duplicate product names found: ' + 
            Product.allInstances().select(p1 | Product.allInstances().exists(p2 | p1 <> p2 and p1.name = p2.name))
            .collect(p | p.name).asSet().toString()
    }
}

context PercentageDiscountAction {
    constraint ValidDiscountPercentage {
        check : self.discountPercentage >= 0 and self.discountPercentage <= 100
        message : 'Percentage-based discount must be between 0 and 100.'
    }
}

context Offer {
    constraint HasInitialRule {
        check : self.offerRule.size() == 1
        message : 'Each Offer must have at least one rule that is not triggered by any other.'
    }
}

context MultiOfferRule {
    constraint TriggerAtMostOneRule {
        check : self.triggerRule.size() <= 1
        message : 'Each rule can only trigger at most one other rule for a given situation.'
    }
    
        constraint AlwaysTriggerRestriction {
        check : not (self.triggerRule.exists(t | t.trigger = TriggerType#ALWAYS) and 
             self.triggerRule.exists(t | t.trigger = TriggerType#IF_MATCH or t.trigger = TriggerType#IF_NOT_MATCH))
        message : 'If a rule "always" triggers another rule, it cannot have "if match" nor "if not match" triggers.'
    }
    
        constraint NoDependencyCycles {
        check : TriggerRule.allInstances().select(t | t.secondaryRule = self).isEmpty()
        message : 'MultiOfferRule should not be triggered by any other rule.'
    }


    
    
}


    
