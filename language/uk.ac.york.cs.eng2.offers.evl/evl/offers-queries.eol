// Offer Rule 1: 10% off from the first 10 orders of Bakewell Tarts in the day
var qualifyingOrdersBakewell = Order.all.select(o |
    o.orderItems.select(oi | 
        oi.product.name == "Bakewell Tart" and 
        OrdersByDay.all.select(obd | obd.product == oi.product and obd.day == today()).size() > 0
    ).size() > 0
);

qualifyingOrdersBakewell.forEach(o | {
    o.totalAmount *= 0.9; // Apply 10% discount
});

// Offer Rule 2: 2 large pizzas for 10 pounds, with one free large ice cream
var qualifyingOrdersPizzaBundle = Order.all.select(o |
    o.orderItems.select(oi | oi.product.name == "Large Pizza").size() == 2
);

qualifyingOrdersPizzaBundle.forEach(o | {
    o.totalAmount = 10; // Set price to £10
    var iceCream = Product.all.selectOne(p | p.name == "Large Ice Cream");
    if (iceCream.isDefined()) {
        o.orderItems.add(new OrderItem(product: iceCream, quantity: 1));
    }
});

// Offer Rule 3: 2 pizzas for the price of 1 (only if the above offer wasn't applied)
var qualifyingOrdersTwoForOnePizza = Order.all.select(o |
    o.orderItems.select(oi | oi.product.name == "Large Pizza").size() == 2 and
    o.appliedOffers.select(offer | offer.name == "Pizza Bundle").size() == 0
);

qualifyingOrdersTwoForOnePizza.forEach(o | {
    var pizzaPrice = o.orderItems.selectOne(oi | oi.product.name == "Large Pizza").product.unitPrice;
    o.totalAmount -= pizzaPrice; // Subtract price of one pizza
});

// Offer Rule 4: 10% discount on Christmas Day (60 GBP minimum order)
var qualifyingOrdersChristmas = Order.all.select(o |
    o.totalAmount >= 60 and today() == "25 Dec"
);

qualifyingOrdersChristmas.forEach(o | {
    o.totalAmount *= 0.9; // Apply 10% discount
});

// Offer Rule 5: 5 pounds off on orders with chocolate cake (50 GBP minimum order, only if Christmas offer does not apply)
var qualifyingOrdersChocolateCake = Order.all.select(o |
    o.totalAmount >= 50 and
    o.orderItems.select(oi | oi.product.name == "Chocolate Cake").size() > 0 and
    o.appliedOffers.select(offer | offer.name == "Christmas Discount").size() == 0
);

qualifyingOrdersChocolateCake.forEach(o | {
    o.totalAmount -= 5; // Apply £5 discount
});
