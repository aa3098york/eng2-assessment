/*
 * Write your EGX rules here: template paths should be relative to the .egx folder.
 */
 
pre {
  "Starting EGX transformation...".println();
   var allRules = OfferRule.all;
   ("Found " + allRules.size() + " OfferRule instances").println();
}
 
rule OfferRules2Java 
  transform orule : OfferRule {
	template: "Test.egl"
	guard : true
	target : "TestItWorks.txt"
}


post {
  "Finished EGX transformation.".println();
}