@namespace(uri="http://cs.york.ac.uk/eng2/202425/offers", prefix="dis")
package offers;

class Model {
	val Product[*] products;
	val Tag[*] tags;
	val Offer[*] offers;
	val Category[*] categories;
}

class Category {
	attr String name;
	val Category[*] subcategories;
	ref Product[*] products;
}

class Offer {
	attr String name;
	val OfferRule offerRule;
}

abstract class Action {
}

class FixedAmountDiscountAction extends Action {
	attr float discountAmount;
}

class SetFixedPriceAction extends Action {
	attr float fixedPrice;
	ref Product product;
	attr int quantity;
}

class PercentageDiscountAction extends Action {
	attr int discountPercentage;
}

class PercentageProductDiscountAction extends PercentageDiscountAction {
	ref Product product;
}

class FreeItemAction extends Action {
	ref Product product;
	attr int quantity;
}

abstract class OfferRule {
	attr String name;
	val Condition[*] conditions;
	val Action[*] actions;
}

class SingleOfferRule extends OfferRule {
}

class MultiOfferRule extends OfferRule {
	val TriggerRule triggerRule;
}

class TriggerRule {
	attr TriggerType trigger;
	ref SingleOfferRule secondaryRule;
}

abstract class Condition {
}

class MinOrderValueCondition extends Condition {
	attr float minimumAmount;
}

class ContainsProductCondition extends Condition {
	ref Product product;
}

class ProductTagCondition extends Condition {
	ref Tag[*] tags;
}


class OrderDateCondition extends Condition {
	attr EDate date;
}

class FirstNOrdersCondition extends Condition {
	attr int numberOfOrders;
	attr EDate day;
	ref Product product;
}

class ProductQuantityCondition extends Condition {
	ref Product product;
	attr int quantity;
}

class Product {
	attr String name;
	attr float unitPrice;
	ref Tag[*] tags;
}

class Tag {
	attr String name;
}

enum TriggerType {
	IF_MATCH = 0;
	IF_NOT_MATCH = 1;
	ALWAYS = 2;
}

